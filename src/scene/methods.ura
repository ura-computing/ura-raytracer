pub fn create() Scene:
    s Scene
    s.light_position = { x: -4.0, y: 6.0, z: 4.0 }
    s.light_color = { x: 1.0, y: 0.9, z: 0.75 }
    up Vec3 = { x: 0.0, y: 1.0, z: 0.0 }

    s.spheres.append(
        Sphere::create(
            { x: 0.0, y: 0.75, z: 0.0 },
            0.75,
            Material::glass(1.5)
        )
    )
    s.spheres.append(
        Sphere::create(
            { x: -1.45, y: 0.6, z: -0.7 },
            0.6,
            Material::mirror(rgb(242.0, 242.0, 242.0))
        )
    )
    s.cylinders.append(
        Cylinder::create(
            { x: 1.35, y: 0.35, z: -0.4 },
            up,
            0.45,
            0.7,
            Material::diffuse(rgb(40.0, 150.0, 160.0))
        )
    )
    s.cones.append(
        Cone::create(
            { x: 1.35, y: 0.7, z: -0.4 },
            up,
            0.4,
            0.9,
            Material::diffuse(rgb(245.0, 150.0, 60.0))
        )
    )

    palette Array<Vec3> = [
        rgb(240.0, 90.0, 90.0),
        rgb(250.0, 190.0, 60.0),
        rgb(110.0, 210.0, 140.0),
        rgb(80.0, 160.0, 240.0),
        rgb(170.0, 110.0, 230.0)
    ]
    for i in Range::create(0, palette.size()):
        angle f64 = ((i - 2) as f64) * 0.38
        center Vec3 = { x: 1.4 * math::sin(angle), y: 0.2, z: 1.3 - 0.9 * (1.0 - math::cos(angle)) }
        s.spheres.append(Sphere::create(center, 0.2, Material::diffuse(palette[i])))

    s.planes.append(
        Plane::create(
            { x: 0.0, y: 0.0, z: 0.0 },
            up,
            Material::diffuse(rgb(160.0, 145.0, 135.0))
        )
    )
    s.planes.append(
        Plane::create(
            { x: 0.0, y: 0.0, z: -4.0 },
            { x: 0.0, y: 0.0, z: 1.0 },
            Material::diffuse(rgb(30.0, 40.0, 75.0))
        )
    )
    s.triangles.append(
        Triangle::create(
            { x: -2.4, y: 0.0, z: -2.6 },
            { x: -0.9, y: 0.0, z: -2.9 },
            { x: -1.6, y: 2.0, z: -2.75 },
            Material::diffuse(rgb(250.0, 210.0, 90.0))
        )
    )
    return s

fn closest_hit(r &Ray, t_min f64, t_max f64, h &Hit) bool:
    closest f64 = t_max
    closest_in<Sphere>(&self.spheres, &r, t_min, &closest, &h)
    closest_in<Plane>(&self.planes, &r, t_min, &closest, &h)
    closest_in<Triangle>(&self.triangles, &r, t_min, &closest, &h)
    closest_in<Rectangle>(&self.rectangles, &r, t_min, &closest, &h)
    closest_in<Cylinder>(&self.cylinders, &r, t_min, &closest, &h)
    closest_in<Cone>(&self.cones, &r, t_min, &closest, &h)
    return closest < t_max

fn occluded(r &Ray, t_min f64, max_distance f64) bool:
    ignored Hit
    return self.closest_hit(r, t_min, max_distance, &ignored)
