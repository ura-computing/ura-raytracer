use "@/core"
use "@/math"
use "@/posix"
use "@/graphics/sdl2"

use "./config"
use "./math"
use "./shapes"
use "./scene"
use "./camera"
use "./trace"

fn to_pixel(c Vec3) Color:
    return Color::create(channel(c.x), channel(c.y), channel(c.z), 255)

fn main() i32:
    window Window = Window::create("ura raytracer", WIDTH, HEIGHT)
    scene Scene = Scene::create()
    camera Camera = Camera::create(WIDTH, HEIGHT)

    accumulated Array<Vec3>
    accumulated.resize(WIDTH * HEIGHT)
    pixels Array<Color>
    pixels.resize(WIDTH * HEIGHT)
    samples i32 = 0
    event Event

    while window.is_open():
        changed bool = False
        while window.poll(&event):
            if event.kind != EventKind::KEY_DOWN:
                continue
            step Vec3
            match event.key:
                case Key::ESCAPE:
                    window.close()
                case Key::R:
                    camera.reset()
                    changed = True
                case Key::UP:
                    step.y = CAMERA_STEP
                case Key::DOWN:
                    step.y = -CAMERA_STEP
                case Key::LEFT:
                    step.x = -CAMERA_STEP
                case Key::RIGHT:
                    step.x = CAMERA_STEP
                case Key::PAGE_UP:
                    step.z = -CAMERA_STEP
                case Key::PAGE_DOWN:
                    step.z = CAMERA_STEP
                default:
                    continue
            if step.length_squared() > 0.0:
                camera.move(step)
                changed = True

        if changed:
            samples = 0
            dark Vec3
            for i in Range::create(0, WIDTH * HEIGHT):
                accumulated[i] = dark

        clock time::Clock = time::Clock::create()
        samples += 1
        inverse f64 = 1.0 / (samples as f64)
        for y in Range::create(0, HEIGHT):
            for x in Range::create(0, WIDTH):
                i i32 = y * WIDTH + x
                accumulated[i] += trace(&scene, camera.ray_for(x, y))
                pixels[i] = to_pixel(accumulated[i] * inverse)

        window.draw(pixels)
        window.present()
        window.set_title($"{clock.elapsed()} ms | {samples} samples")
    return 0
