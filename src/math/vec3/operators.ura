operator +(left &Vec3, right &Vec3) Vec3:
    return {
        x: left.x + right.x,
        y: left.y + right.y,
        z: left.z + right.z
    }

operator -(left &Vec3, right &Vec3) Vec3:
    return {
        x: left.x - right.x,
        y: left.y - right.y,
        z: left.z - right.z
    }

operator *(left &Vec3, right &Vec3) Vec3:
    return {
        x: left.x * right.x,
        y: left.y * right.y,
        z: left.z * right.z
    }

operator *(left &Vec3, t f64) Vec3:
    return {
        x: left.x * t,
        y: left.y * t,
        z: left.z * t
    }

operator /(left &Vec3, t f64) Vec3:
    return {
        x: left.x / t,
        y: left.y / t,
        z: left.z / t
    }

operator +=(left &Vec3, right &Vec3):
    left.x += right.x
    left.y += right.y
    left.z += right.z
