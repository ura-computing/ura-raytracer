operator +(o &Vec3) Vec3:
    return {
        x: self.x + o.x,
        y: self.y + o.y,
        z: self.z + o.z
    }

operator -(o &Vec3) Vec3:
    return {
        x: self.x - o.x,
        y: self.y - o.y,
        z: self.z - o.z
    }

operator *(o &Vec3) Vec3:
    return {
        x: self.x * o.x,
        y: self.y * o.y,
        z: self.z * o.z
    }

operator *(t f64) Vec3:
    return {
        x: self.x * t,
        y: self.y * t,
        z: self.z * t
    }

operator /(t f64) Vec3:
    return {
        x: self.x / t,
        y: self.y / t,
        z: self.z / t
    }

operator +=(o &Vec3):
    self.x += o.x
    self.y += o.y
    self.z += o.z
